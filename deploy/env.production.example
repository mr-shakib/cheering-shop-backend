# Copy to deploy/.env.production on the SERVER and fill in.
# This file must never be committed — deploy/.env.production is gitignored.
#
# Generate every secret with:  openssl rand -hex 32

# --- Your domain (DNS A record must already point at this VPS) --------------
DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --- Application ------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Unset = docs served everywhere except production. Set true if your frontend
# team needs /docs on this host; it publishes your whole API surface.
# ENABLE_DOCS=false
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database (self-hosted; never exposed outside the docker network) -------
POSTGRES_USER=crshop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=crshop

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Secrets: four DIFFERENT values, never reused ---------------------------
JWT_SECRET_KEY=CHANGE_ME
RIDER_PIN_PEPPER=CHANGE_ME
OTP_PEPPER=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME

# --- Connection pool: 2 uvicorn workers x (10+5) + worker ~= 35 of 100 ------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Object storage (fill in when the vendor upload flow lands) -------------
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
