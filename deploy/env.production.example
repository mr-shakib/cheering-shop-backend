# Copy to deploy/.env.production on the SERVER and fill in.
# This file must never be committed — deploy/.env.production is gitignored.
#
# Generate every secret with:  openssl rand -hex 32

# --- Your domain (DNS A record must already point at this VPS) --------------
DOMAIN=api.yourdomain.com
# Optional: serve the admin console at the root of this subdomain (see docs/ADMIN-APP.md).
# Point its A record at this server too. Leave empty to keep the console at /admin/ on DOMAIN.
ADMIN_UI_HOST=admin.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# --- Application ------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Unset = docs served everywhere except production. Set true if your frontend
# team needs /docs on this host; it publishes your whole API surface.
# ENABLE_DOCS=false
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database (self-hosted; never exposed outside the docker network) -------
POSTGRES_USER=crshop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=crshop

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Secrets: four DIFFERENT values, never reused ---------------------------
JWT_SECRET_KEY=CHANGE_ME
RIDER_PIN_PEPPER=CHANGE_ME
OTP_PEPPER=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME

# --- Connection pool: 2 uvicorn workers x (10+5) + worker ~= 35 of 100 ------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Sign in with Google (leave blank to keep /auth/google/* disabled) -------
# Google Cloud console -> Google Auth Platform -> Clients -> "Web application".
# The redirect URI below must be registered on that client byte-for-byte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.${DOMAIN}/api/v1/auth/google/callback
# The custom scheme the mobile app registers. Exact-match allowlist.
GOOGLE_POST_AUTH_REDIRECTS=crshop://auth/callback

# --- Object storage (fill in when the vendor upload flow lands) -------------
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
