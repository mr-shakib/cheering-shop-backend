# Caddy obtains and renews Let's Encrypt certificates automatically. The only
# prerequisite is that {$DOMAIN} already resolves to this server's IP — ACME
# validation fails otherwise, so point DNS BEFORE starting this container.

{
	email {$ACME_EMAIL}
	# Uncomment while testing to avoid Let's Encrypt's rate limits
	# (5 failed issuances per hostname per hour will lock you out for an hour):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ADMIN_DOMAIN is the admin console's subdomain (ADMIN_UI_HOST in .env). It is
# served by the same upstream: the app looks at the Host header and serves the
# console at "/" for that name. When unset Caddy sees an empty label and simply
# serves DOMAIN alone.
{$DOMAIN} {$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		# HSTS: browsers refuse plain HTTP to this host for a year. Only enable
		# once you are certain TLS works — it is cached and hard to undo.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No Content-Security-Policy here: the app sets one per path in
		# SecurityHeadersMiddleware — strict for the JSON API, script-friendly
		# for the admin console. A CSP set in Caddy would override the app's
		# and break the console.
		-Server
	}

	# reverse_proxy handles WebSocket upgrades natively, which the two live
	# channels (/ws/orders/{id}/live-tracking and /ws/vendor/live) depend on.
	reverse_proxy api:8000 {
		header_up X-Real-IP {remote_host}

		# Live tracking sockets are long-lived; a short timeout would drop a
		# customer's map mid-delivery.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}
