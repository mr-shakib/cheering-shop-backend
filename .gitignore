__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Production secrets — never commit
deploy/.env.production
backups/

# Pasted Dokploy environment (contains production secrets) — never commit.
dokploy.env

# Google OAuth client downloads (contain the client secret) — never commit.
client_secret_*.json

# The admin console build (admin-web/ -> `make admin-build`); the Docker image
# builds its own copy.
app/static/admin/

# Firebase service-account keys (contain a private key) — never commit.
*-firebase-adminsdk-*.json
