# Copy to .env and fill in. Secrets have no defaults — the app refuses to boot
# without them rather than silently running on a well-known development key.
# Host ports for docker compose (container-internal ports are unchanged)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

ENVIRONMENT=local
# Serve /docs? Unset = every environment except production.
# ENABLE_DOCS=false
DEBUG=true

DATABASE_URL=postgresql+psycopg://crshop:crshop@localhost:5433/crshop
REDIS_URL=redis://localhost:6379/0

# Generate each with:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
RIDER_PIN_PEPPER=CHANGE_ME_openssl_rand_hex_32
OTP_PEPPER=CHANGE_ME_openssl_rand_hex_32
TOTP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Reverse proxy: set to the proxy's IP (or subnet) when deployed behind
# Caddy/nginx. Leave empty for direct access. NEVER "*" on a public host.
FORWARDED_ALLOW_IPS=

# --- Email (Resend) ---------------------------------------------------
# Leave RESEND_API_KEY empty locally: codes are logged instead of mailed.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Cheering Shop

# --- Sign in with Google ----------------------------------------------
# Leave GOOGLE_CLIENT_ID empty and /auth/google/* return 501; everything else
# works. To enable: console.cloud.google.com -> Google Auth Platform ->
# Clients -> Create client -> "Web application" (NOT Android/iOS: Google talks
# only to this backend, never to the phone).
#
# Register BOTH of these on that client as Authorized redirect URIs, exactly:
#   https://api.cheeringshop.online/api/v1/auth/google/callback
#   http://localhost:8000/api/v1/auth/google/callback
# A single character of difference gives you redirect_uri_mismatch before the
# user ever sees a consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Where the callback deep-links the browser back into the mobile app, which
# must claim this scheme in AndroidManifest.xml and Info.plist. Comma-separated
# allowlist; the client picks one with ?redirect= on /auth/google/authorize.
# Only these exact strings are accepted — an unchecked redirect target here
# would hand the session tokens to whoever asked for them.
GOOGLE_POST_AUTH_REDIRECTS=crshop://auth/callback

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Commission -------------------------------------------------------
# What a newly created restaurant is priced at, in basis points (1500 == 15%).
# Existing restaurants are untouched by this; reprice one with
# PATCH /admin/restaurants/{id}/commission. Do not set it to 0 casually: each
# order snapshots the rate it was charged, so orders taken at 0% stay at 0%.
DEFAULT_COMMISSION_BASIS_POINTS=1500

# --- Object storage (Cloudflare R2) -----------------------------------
# Leave blank locally: /uploads/presigned-url returns 503 and every other
# endpoint works. To enable it, create an R2 bucket, make an API token scoped
# to it (Object Read & Write), and bind a public domain to the bucket.
# R2_PUBLIC_BASE_URL is that public domain — either the managed r2.dev
# subdomain or your own CDN host. It is NOT the endpoint below: R2's S3 API
# refuses unauthenticated reads, so uploads would land bytes nobody can fetch.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Optional. Derived from R2_ACCOUNT_ID unless the bucket is jurisdiction-locked
# (https://<account>.eu.r2.cloudflarestorage.com) or you point this at MinIO.
# R2_ENDPOINT_URL=
